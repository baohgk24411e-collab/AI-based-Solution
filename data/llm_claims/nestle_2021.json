    },
    {
      "claim_text": "Our vision is ambitious: a world in which none of Nestlé’s packaging, including plastics, ends up in landfill or as litter on land or in seas, oceans and waterways.",
      "source_page": 35,
      "claim_type": "target",
      "scope": null,
      "material": "plastics",
      "unit": null,
      "measurement_year": null,
      "target_year": null,
      "value": null,
      "claim_id": "nestle_2021_2d4eaf3a31af",
