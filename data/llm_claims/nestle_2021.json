      "company": "Nestlé",
      "report_year": 2021,
      "assessment": "not_assessed",
      "extraction_method": "lmstudio",
      "review_status": "candidate_needs_review"
    },
    {
      "claim_text": "In 2019, Nestlé joined the Ellen MacArthur Foundation’s New Plastics Economy initiative. We pledged to work across the industry to create a circular economy for plastic, starting with packaging – eliminating unnecessary plastic in our packaging and innovating to make the plastic that we do need recyclable and reusable.",
      "source_page": 35,
      "claim_type": "target",
      "scope": null,
      "material": "plastics",
      "unit": null,
      "measurement_year": null,
      "target_year": null,
      "value": null,
      "claim_id": "nestle_2021_43632738e7c7",
      "report_id": "nestle_2021",
      "company": "Nestlé",
      "report_year": 2021,
      "assessment": "not_assessed",
      "extraction_method": "lmstudio",
      "review_status": "candidate_needs_review"
    },
    {
      "claim_text": "We are reducing packaging materials by removing unnecessary plastic lids, accessories, layers and films.",
      "source_page": 35,
      "claim_type": "recyclability",
      "scope": null,
      "material": "plastics",
      "unit": null,
      "measurement_year": null,
      "target_year": null,
      "value": null,
      "claim_id": "nestle_2021_918508d82085",
      "report_id": "nestle_2021",
      "company": "Nestlé",
      "report_year": 2021,
      "assessment": "not_assessed",
      "extraction_method": "lmstudio",
      "review_status": "candidate_needs_review"
    },
    {
      "claim_text": "Worldwide, we transitioned our Smarties range of products to recyclable paper packaging, a first for any global confectionery brand. This transition helped eliminate plastic from approximately 250 million packs sold globally each year.",
      "source_page": 35,
      "claim_type": "recycled_content",
      "scope": null,
      "material": "plastics",
      "unit": "packs",
      "measurement_year": null,
      "target_year": null,
      "value": 250000000,
      "claim_id": "nestle_2021_72a151993d07",
