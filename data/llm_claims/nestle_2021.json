      "company": "Nestlé",
      "report_year": 2021,
      "assessment": "not_assessed",
      "extraction_method": "lmstudio",
      "review_status": "candidate_needs_review"
    },
    {
      "claim_text": "In 2021, this amounted to 18 000 tonnes of PET through the Dorna initiative, a collaboration with the Egyptian Ministry of Environment, together with partners CID Consulting and PayMob.",
      "source_page": 35,
      "claim_type": "recycled_content",
      "scope": null,
      "material": "PET (plastics)",
      "unit": "tonnes",
      "measurement_year": 2021,
      "target_year": null,
      "value": 18000,
      "claim_id": "nestle_2021_2223f8d44c6f",
      "report_id": "nestle_2021",
      "company": "Nestlé",
      "report_year": 2021,
      "assessment": "not_assessed",
      "extraction_method": "lmstudio",
      "review_status": "candidate_needs_review"
    },
    {
      "claim_text": "Other areas of innovation include more simplified packaging, refillable designs, alternative delivery solutions and high-performance technology for paper barriers as well as increasing recycled  and bio-based content and compostable  and biodegradable materials.",
      "source_page": 36,
      "claim_type": "target",
      "scope": null,
      "material": "paper, polymers",
      "unit": null,
      "measurement_year": null,
      "target_year": null,
      "value": null,
